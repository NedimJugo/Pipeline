{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=pipeline;Username=pipeline;Password=change-me"
  },
  "Jwt": {
    "Secret": "very-secure-jwt-secret-key-that-is-at-least-32-chars-long!",
    "Issuer": "pipeline",
    "Audience": "pipeline-web"
  },
  "Frontend": {
    "Origin": "http://localhost:5173"
  },
  "AUTO_MIGRATE": true,
  "AllowedHosts": "*"
}
